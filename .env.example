# Template for the Docker .env file. Copy to .env and fill in real values:
#   cp .env.example .env
# The .env file itself is gitignored so secrets stay out of version control.
# Compose reads these to configure the db service - the api container isn't
# run through Compose right now, so nothing here feeds it directly.

POSTGRES_DB=AgroShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
