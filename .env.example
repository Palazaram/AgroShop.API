# Template for the Docker .env file. Copy to .env and fill in real values:
#   cp .env.example .env
# The .env file itself is gitignored so secrets stay out of version control.

POSTGRES_DB=AgroShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Base64 signing key for JWT (use a strong, unique value in production).
JWT_SECRET_KEY=
